{
  "expo": {
    "name": "WonderFat Scanner",
    "slug": "wonderfat-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B4332"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wonderfat.scanner",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "WonderFat Scanner needs camera access to scan product barcodes and analyze ingredients for your health.",
        "NSPhotoLibraryUsageDescription": "WonderFat Scanner needs photo library access to let you scan product labels from saved images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B4332"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.wonderfat.scanner",
      "versionCode": 1,
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "WonderFat Scanner needs camera access to scan product barcodes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
